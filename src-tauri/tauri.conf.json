{
  "version": "0.0.1",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": true,
    "longDescription": "MEOW, an independent fork of Clash Verge Rev",
    "icon": [
      "../.generated/application/icons/32x32.png",
      "../.generated/application/icons/128x128.png",
      "../.generated/application/icons/128x128@2x.png",
      "../.generated/application/icons/icon.icns",
      "../.generated/application/icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "../.generated/application/app-dmg-background.png"
      }
    },
    "resources": ["resources"],
    "publisher": "SHIRO",
    "externalBin": ["sidecar/meow-mihomo", "sidecar/meow-mihomo-alpha"],
    "copyright": "Copyright © 2026 SHIRO. Based on Clash Verge Rev.",
    "category": "DeveloperTool",
    "shortDescription": "MEOW desktop proxy client",
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "pnpm run tauri:before-build",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run tauri:before-dev",
    "devUrl": "http://localhost:3000/",
    "removeUnusedCommands": true
  },
  "productName": "MEOW",
  "identifier": "io.github.shiro-design-16.meow",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyOEMyRjBCQkVGOUJEREYKUldUZnZmbStDeStNMHU5Mmo1N24xQXZwSVRYbXA2NUpzZE5oVzlqeS9Bc0t6RVV4MmtwVjBZaHgK",
      "endpoints": [
        "https://github.com/Shiro-Design-16/MEOW/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["meow"]
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "capabilities": ["desktop-capability", "migrated"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  }
}
